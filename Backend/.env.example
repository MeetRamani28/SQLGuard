# SQLGuard Application Environment Configuration
APP_ENV=development
PROJECT_NAME=SQLGuard
GROQ_API_KEY=your_groq_api_key_here
MODEL_NAME=openai/gpt-oss-20b

# Database Configuration (Dev SQLite default, or user custom/live DB)
SQLITE_DB_PATH=./sqlguard_dev.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sqlguard_db

# Vector store (Schema-RAG) Settings
CHROMA_PERSIST_DIR=./.chroma_db
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=sqlguard-schema

# Security & Auth Settings
MOCK_AUTH_BYPASS=true
SECRET_KEY=dev-secret-key-change-in-production